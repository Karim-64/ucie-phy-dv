<uvm_env name="DEMUX">
    <parameters>
    </parameters>
        <clock name="clk"/>
        <signals>
        <signal name="lp_data" width="512" direction="drv"/>
        <signal name="SEL_4" width="1" direction="drv"/>
        <signal name="lp_data_0" width="512" direction="mon"/>
        <signal name="lp_data_1" width="512" direction="mon"/>
    </signals>
    <dut>
        <module_name>DEMUX</module_name>
        <instance_name>dut</instance_name>
        <port dut_port="clk" signal="clk"/>
        <port dut_port="lp_data" signal="lp_data"/>
        <port dut_port="SEL_4" signal="SEL_4"/>
        <port dut_port="lp_data_0" signal="lp_data_0"/>
        <port dut_port="lp_data_1" signal="lp_data_1"/>
    </dut>
    <env>
        <has_scoreboard>true</has_scoreboard>
        <has_subscriber>true</has_subscriber>
    </env>
</uvm_env>