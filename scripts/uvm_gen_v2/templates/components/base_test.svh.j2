`ifndef {{ spec.upper }}_BASE_TEST_SVH
`define {{ spec.upper }}_BASE_TEST_SVH

class {{ spec.name }}_base_test extends uvm_test;
  `uvm_component_utils({{ spec.name }}_base_test)

  {{ spec.name }}_environment env;
  {{ spec.name }}_env_cfg_obj env_cfg;

  function new(string name = "{{ spec.name }}_base_test", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);

    // Create and configure the environment config object
    env_cfg = {{ spec.name }}_env_cfg_obj::type_id::create("env_cfg");

    // Retrieve the virtual interface from config_db (set in tb_top)
    if (!uvm_config_db#(virtual {{ spec.name }}_if#({{ spec.if_param_port_list }}))::get(
            this, "", "{{ spec.upper }}_VIF", env_cfg.{{ spec.name }}_vif))
      `uvm_fatal("{{ spec.upper }}_TEST", "{{ spec.upper }}_VIF not found in config_db")

    // Enable all components
    env_cfg.{{ spec.name }}_has_agent      = 1;
{% if spec.env.has_scoreboard %}
    env_cfg.{{ spec.name }}_has_scoreboard = 1;
{% endif %}
{% if spec.env.has_subscriber %}
    env_cfg.{{ spec.name }}_has_subscriber = 1;
{% endif %}
    env_cfg.active_passive_agents["{{ spec.name }}"] = UVM_ACTIVE;

    uvm_config_db#({{ spec.name }}_env_cfg_obj)::set(this, "env", "cfg", env_cfg);

    env = {{ spec.name }}_environment::type_id::create("env", this);
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
  endfunction

  task run_phase(uvm_phase phase);
    super.run_phase(phase);
    // TODO: Start sequences on the sequencer
    // e.g. {{ spec.name }}_base_sequence seq = {{ spec.name }}_base_sequence::type_id::create("seq");
    // phase.raise_objection(this);
    // seq.start(env.agt.seqr);
    // phase.drop_objection(this);
  endtask
endclass

`endif // {{ spec.upper }}_BASE_TEST_SVH
