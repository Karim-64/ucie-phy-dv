`ifndef {{ agent.prefix | upper }}_AGENT_SVH
`define {{ agent.prefix | upper }}_AGENT_SVH

class {{ agent.cls('agent') }} extends uvm_agent;
  `uvm_component_utils({{ agent.cls('agent') }})

{% if agent.is_active %}
  {{ agent.cls('sequencer') }} seqr;
  {{ agent.cls('driver') }} drv;
{% endif %}
  {{ agent.cls('monitor') }} mon;

  {{ agent.cls('agt_cfg_obj') }} cfg;
  {{ agent.cls('drv_mon_cfg_obj') }} drv_mon_cfg;
  uvm_analysis_port#({{ agent.item }}) agt_aport;

  function new(string name = "{{ agent.cls('agent') }}", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);

    if (!uvm_config_db#({{ agent.cls('agt_cfg_obj') }})::get(this, "", "cfg", cfg))
      `uvm_fatal("{{ agent.prefix | upper }}_AGENT", "{{ agent.cls('agt_cfg_obj') }} not found in config_db for {{ agent.cls('agent') }}")

    drv_mon_cfg = {{ agent.cls('drv_mon_cfg_obj') }}::type_id::create("drv_mon_cfg");
    drv_mon_cfg.{{ spec.name }}_vif = cfg.{{ spec.name }}_vif;

    uvm_config_db#({{ agent.cls('drv_mon_cfg_obj') }})::set(this, "*", "cfg", drv_mon_cfg);
{% if agent.is_active %}

    if (cfg.is_active == UVM_ACTIVE) begin
      seqr = {{ agent.cls('sequencer') }}::type_id::create("seqr", this);
      drv = {{ agent.cls('driver') }}::type_id::create("drv", this);
    end
{% endif %}

    mon = {{ agent.cls('monitor') }}::type_id::create("mon", this);
    agt_aport = new("agt_aport", this);
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
{% if agent.is_active %}
    if (cfg.is_active == UVM_ACTIVE) begin
      drv.seq_item_port.connect(seqr.seq_item_export);
      seqr.seqr_aport.connect(mon.mon_aimp);
      mon.mon_aport.connect(seqr.seqr_aexport);
    end
{% endif %}
    mon.mon_aport.connect(agt_aport);
  endfunction
endclass

`endif // {{ agent.prefix | upper }}_AGENT_SVH
