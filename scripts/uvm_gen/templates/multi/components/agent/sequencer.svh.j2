`ifndef {{ agent.prefix | upper }}_SEQUENCER_SVH
`define {{ agent.prefix | upper }}_SEQUENCER_SVH

class {{ agent.cls('sequencer') }} extends uvm_sequencer #({{ agent.item }});
  `uvm_component_utils({{ agent.cls('sequencer') }})

  // seqr_aport  : sequences publish the item they are driving to the monitor (mon_aimp)
  // seqr_aexport: monitor feedback (sampled responses) for reactive sequences
  uvm_analysis_port#({{ agent.item }}) seqr_aport;
  uvm_analysis_export#({{ agent.item }}) seqr_aexport;
  uvm_tlm_analysis_fifo#({{ agent.item }}) seqr_fifo;

  function new(string name = "{{ agent.cls('sequencer') }}", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    seqr_aport = new("seqr_aport", this);
    seqr_aexport = new("seqr_aexport", this);
    seqr_fifo = new("seqr_fifo", this);
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    seqr_aexport.connect(seqr_fifo.analysis_export);
  endfunction
endclass

`endif // {{ agent.prefix | upper }}_SEQUENCER_SVH
