`ifndef {{ spec.upper }}_SCOREBOARD_SVH
`define {{ spec.upper }}_SCOREBOARD_SVH

class {{ spec.name }}_scoreboard extends uvm_scoreboard;
  `uvm_component_utils({{ spec.name }}_scoreboard)

{% for a in spec.sb_agents %}
  uvm_analysis_export#({{ a.item }}) sb_{{ a.lower }}_aexport;
{% endfor %}

{% for a in spec.sb_agents %}
  uvm_tlm_analysis_fifo#({{ a.item }}) sb_{{ a.lower }}_fifo;
{% endfor %}
{% if spec.sb_checked_agents %}

  // Expected outputs generated by the reference model
{% for a in spec.sb_checked_agents %}
  {{ a.item }} {{ a.lower }}_exp_out;
{% endfor %}
{% endif %}

  // TODO: Reference model state variables

  // Scoreboard statistics
  int pass_count;
  int error_count;

  function new(string name = "{{ spec.name }}_scoreboard", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
{% for a in spec.sb_agents %}
    sb_{{ a.lower }}_aexport = new("sb_{{ a.lower }}_aexport", this);
{% endfor %}

{% for a in spec.sb_agents %}
    sb_{{ a.lower }}_fifo = new("sb_{{ a.lower }}_fifo", this);
{% endfor %}

{% for a in spec.sb_checked_agents %}
    {{ a.lower }}_exp_out = {{ a.item }}::type_id::create("{{ a.lower }}_exp_out");
{% endfor %}

    pass_count = 0;
    error_count = 0;
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);

{% for a in spec.sb_agents %}
    sb_{{ a.lower }}_aexport.connect(sb_{{ a.lower }}_fifo.analysis_export);
{% endfor %}
  endfunction

  task run_phase(uvm_phase phase);
{% for a in spec.sb_agents %}
    {{ a.item }} {{ a.lower }}_item;
{% endfor %}

    super.run_phase(phase);

    // Skip the first item, all the modules are initialized to 0, so the first item is not valid
{% for a in spec.sb_agents %}
    sb_{{ a.lower }}_fifo.get({{ a.lower }}_item);
{% endfor %}

    forever begin
{% for a in spec.sb_agents %}
      sb_{{ a.lower }}_fifo.get({{ a.lower }}_item);
{% endfor %}

      ref_model({{ spec.sb_input_agents | map(attribute='lower') | map('suffix', '_item') | join(', ') }});
      check_results({{ spec.sb_agents | map(attribute='lower') | map('suffix', '_item') | join(', ') }});
    end
  endtask

  function void report_phase(uvm_phase phase);
    super.report_phase(phase);
    `uvm_info("{{ spec.upper }}_SB", "==================================================", UVM_NONE)
    `uvm_info("{{ spec.upper }}_SB", "             SCOREBOARD SUMMARY REPORT            ", UVM_NONE)
    `uvm_info("{{ spec.upper }}_SB", "==================================================", UVM_NONE)
    `uvm_info("{{ spec.upper }}_SB", $sformatf("  Pass Count  : %0d", pass_count), UVM_NONE)
    `uvm_info("{{ spec.upper }}_SB", $sformatf("  Error Count : %0d", error_count), UVM_NONE)
    `uvm_info("{{ spec.upper }}_SB", "==================================================", UVM_NONE)
  endfunction

  // Computes the expected DUT outputs for this cycle from the stimulus items
  function void ref_model({% for a in spec.sb_input_agents %}{{ a.item }} {{ a.lower }}_item{{ ", " if not loop.last }}{% endfor %});
    // TODO: Implement the reference model and fill in the expected outputs:
{% for a in spec.sb_checked_agents %}
{% for s in a.checked_signals %}
    // {{ a.lower }}_exp_out.{{ s.name }} = ...;
{% endfor %}
{% endfor %}
  endfunction

  // Compares the observed DUT outputs against the reference model
  function void check_results({% for a in spec.sb_agents %}{{ a.item }} {{ a.lower }}_item{{ ", " if not loop.last }}{% endfor %});
    bit has_error = 1'b0;
{% for a in spec.sb_checked_agents %}

    // Check {{ a.name }} outputs against {{ a.lower }}_exp_out
{% for s in a.checked_signals %}
{% if s.is_unpacked %}
    foreach ({{ a.lower }}_item.{{ s.name }}[i]) begin
      if ({{ a.lower }}_item.{{ s.name }}[i] !== {{ a.lower }}_exp_out.{{ s.name }}[i]) begin
        `uvm_error("{{ spec.upper }}_SB", $sformatf("{{ a.name }} {{ s.name }}[%0d] Mismatch! Exp: {{ '%0b' if (s.width == '1' and not s.is_packed_array) else '0x%0h' }}, Act: {{ '%0b' if (s.width == '1' and not s.is_packed_array) else '0x%0h' }}", i, {{ a.lower }}_exp_out.{{ s.name }}[i], {{ a.lower }}_item.{{ s.name }}[i]))
        error_count++;
        has_error = 1'b1;
      end
    end
{% else %}
    if ({{ a.lower }}_item.{{ s.name }} !== {{ a.lower }}_exp_out.{{ s.name }}) begin
      `uvm_error("{{ spec.upper }}_SB", $sformatf("{{ a.name }} {{ s.name }} Mismatch! Exp: {{ s.fmt }}, Act: {{ s.fmt }}", {{ a.lower }}_exp_out.{{ s.name }}, {{ a.lower }}_item.{{ s.name }}))
      error_count++;
      has_error = 1'b1;
    end
{% endif %}
{% endfor %}
{% endfor %}

    if (!has_error) begin
      pass_count++;
    end
  endfunction
endclass

`endif // {{ spec.upper }}_SCOREBOARD_SVH
