`ifndef {{ spec.upper }}_AGENT_SVH
`define {{ spec.upper }}_AGENT_SVH

class {{ spec.name }}_agent extends uvm_agent;
  `uvm_component_utils({{ spec.name }}_agent)

  {{ spec.name }}_sequencer seqr;
  {{ spec.name }}_driver drv;
  {{ spec.name }}_monitor mon;

  {{ spec.name }}_agt_cfg_obj cfg;
  {{ spec.name }}_drv_mon_cfg_obj drv_mon_cfg;
  uvm_analysis_port#({{ spec.name }}_sequence_item) agt_aport;

  function new(string name = "{{ spec.name }}_agent", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);

    if (!uvm_config_db#({{ spec.name }}_agt_cfg_obj)::get(this, "", "cfg", cfg))
      `uvm_fatal("{{ spec.upper }}_AGENT", "{{ spec.name }}_cfg_obj not found in config_db for {{ spec.name }}_agent")

    drv_mon_cfg = {{ spec.name }}_drv_mon_cfg_obj::type_id::create("drv_mon_cfg");
    drv_mon_cfg.{{ spec.name }}_vif = cfg.{{ spec.name }}_vif;

    uvm_config_db#({{ spec.name }}_drv_mon_cfg_obj)::set(this, "*", "cfg", drv_mon_cfg);

    if (cfg.is_active == UVM_ACTIVE) begin
      seqr = {{ spec.name }}_sequencer::type_id::create("seqr", this);
      drv = {{ spec.name }}_driver::type_id::create("drv", this);
    end

    mon = {{ spec.name }}_monitor::type_id::create("mon", this);
    agt_aport = new("agt_aport", this);
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    if (cfg.is_active == UVM_ACTIVE) begin
      drv.seq_item_port.connect(seqr.seq_item_export);
      seqr.seqr_aport.connect(mon.mon_aimp);
    end
    mon.mon_aport.connect(agt_aport);
  endfunction
endclass

`endif // {{ spec.upper }}_AGENT_SVH
