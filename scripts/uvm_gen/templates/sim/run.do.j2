{% set dut = spec.dut.module_name if spec.dut else "DUT" %}
vlib work

# 1. Compile RTL with all code coverage types enabled (RTL only)
vlog +cover=bcesft ../RTL/*.sv

# 2. Compile UVM package, interface, and testbench (no coverage instrumentation on TB code)
vlog +incdir+../ ../packages/{{ spec.name }}_pkg.sv ../interfaces/{{ spec.name }}_if.sv ../tb/tb_top.sv

# 3. Elaborate and simulate
#    -onfinish stop : $finish (from UVM) stops instead of exiting, so the coverage commands below still run
vsim -voptargs=+acc -classdebug work.tb_top -coverage -uvmcontrol=all \
     +UVM_TESTNAME={{ spec.name }}_base_test -onfinish stop

# Safety net: save the UCDB even if the session exits unexpectedly
coverage save -onexit {{ spec.name }}_coverage.ucdb

run 0
# catch {do wave.do}
run -all

# ==============================================================================
# COVERAGE REPORTING (DUT ONLY, SUMMARY IN TERMINAL, DETAIL TO FILE)
# ==============================================================================
coverage save {{ spec.name }}_coverage.ucdb

echo "=================================================="
echo ">>> DUT CODE COVERAGE SUMMARY"
echo "=================================================="
coverage report -du=work.{{ dut }} -code bcesft -summary

echo "=================================================="
echo ">>> FUNCTIONAL COVERAGE (COVERGROUPS) SUMMARY"
echo "=================================================="
coverage report -cvg -summary

# Detailed breakdown to file: DUT code coverage first, then covergroups appended
coverage report -output coverage_detailed_report.txt -details -du=work.{{ dut }} -code bcesft
coverage report -output coverage_detailed_report.txt -append -details -cvg

echo ">>> Detailed coverage written to coverage_detailed_report.txt"

# quit -f