`ifndef PE_SBTX_SCOREBOARD_SVH
`define PE_SBTX_SCOREBOARD_SVH

class pe_sbtx_scoreboard extends uvm_scoreboard;
  `uvm_component_utils(pe_sbtx_scoreboard)

  uvm_analysis_export#(pe_sbtx_D2D_sequence_item) sb_d2d_aexport;
  uvm_analysis_export#(pe_sbtx_PHY_sequence_item) sb_phy_aexport;
  uvm_analysis_export#(pe_sbtx_FIFO_sequence_item) sb_fifo_aexport;

  uvm_tlm_analysis_fifo#(pe_sbtx_D2D_sequence_item) sb_d2d_fifo;
  uvm_tlm_analysis_fifo#(pe_sbtx_PHY_sequence_item) sb_phy_fifo;
  uvm_tlm_analysis_fifo#(pe_sbtx_FIFO_sequence_item) sb_fifo_fifo;

  // Expected outputs generated by the reference model
  pe_sbtx_D2D_sequence_item d2d_exp_out;
  pe_sbtx_PHY_sequence_item phy_exp_out;
  pe_sbtx_FIFO_sequence_item fifo_exp_out;

  // TODO: Reference model state variables

  // Scoreboard statistics
  int pass_count;
  int error_count;

  function new(string name = "pe_sbtx_scoreboard", uvm_component parent = null);
    super.new(name, parent);
  endfunction

  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    sb_d2d_aexport = new("sb_d2d_aexport", this);
    sb_phy_aexport = new("sb_phy_aexport", this);
    sb_fifo_aexport = new("sb_fifo_aexport", this);

    sb_d2d_fifo = new("sb_d2d_fifo", this);
    sb_phy_fifo = new("sb_phy_fifo", this);
    sb_fifo_fifo = new("sb_fifo_fifo", this);

    d2d_exp_out = pe_sbtx_D2D_sequence_item::type_id::create("d2d_exp_out");
    phy_exp_out = pe_sbtx_PHY_sequence_item::type_id::create("phy_exp_out");
    fifo_exp_out = pe_sbtx_FIFO_sequence_item::type_id::create("fifo_exp_out");

    pass_count = 0;
    error_count = 0;
  endfunction

  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);

    sb_d2d_aexport.connect(sb_d2d_fifo.analysis_export);
    sb_phy_aexport.connect(sb_phy_fifo.analysis_export);
    sb_fifo_aexport.connect(sb_fifo_fifo.analysis_export);
  endfunction

  task run_phase(uvm_phase phase);
    pe_sbtx_D2D_sequence_item d2d_item;
    pe_sbtx_PHY_sequence_item phy_item;
    pe_sbtx_FIFO_sequence_item fifo_item;

    super.run_phase(phase);

    // Skip the first item, all the modules are initialized to 0, so the first item is not valid
    sb_d2d_fifo.get(d2d_item);
    sb_phy_fifo.get(phy_item);
    sb_fifo_fifo.get(fifo_item);

    forever begin
      sb_d2d_fifo.get(d2d_item);
      sb_phy_fifo.get(phy_item);
      sb_fifo_fifo.get(fifo_item);

      ref_model(d2d_item, phy_item);
      check_results(d2d_item, phy_item, fifo_item);
    end
  endtask

  function void report_phase(uvm_phase phase);
    super.report_phase(phase);
    `uvm_info("PE_SBTX_SB", "==================================================", UVM_NONE)
    `uvm_info("PE_SBTX_SB", "             SCOREBOARD SUMMARY REPORT            ", UVM_NONE)
    `uvm_info("PE_SBTX_SB", "==================================================", UVM_NONE)
    `uvm_info("PE_SBTX_SB", $sformatf("  Pass Count  : %0d", pass_count), UVM_NONE)
    `uvm_info("PE_SBTX_SB", $sformatf("  Error Count : %0d", error_count), UVM_NONE)
    `uvm_info("PE_SBTX_SB", "==================================================", UVM_NONE)
  endfunction

  // Computes the expected DUT outputs for this cycle from the stimulus items
  function void ref_model(pe_sbtx_D2D_sequence_item d2d_item, pe_sbtx_PHY_sequence_item phy_item);
    // TODO: Implement the reference model and fill in the expected outputs:
    // d2d_exp_out.resend_req = ...;
    // phy_exp_out.resend_req = ...;
    // fifo_exp_out.fifo_wr = ...;
    // fifo_exp_out.fifo_data = ...;
    // fifo_exp_out.data_marker = ...;
    // fifo_exp_out.d2d_phy_marker = ...;
    // fifo_exp_out.comp_marker = ...;
  endfunction

  // Compares the observed DUT outputs against the reference model
  function void check_results(pe_sbtx_D2D_sequence_item d2d_item, pe_sbtx_PHY_sequence_item phy_item, pe_sbtx_FIFO_sequence_item fifo_item);
    bit has_error = 1'b0;

    // Check D2D outputs against d2d_exp_out
    if (d2d_item.resend_req !== d2d_exp_out.resend_req) begin
      `uvm_error("PE_SBTX_SB", $sformatf("D2D resend_req Mismatch! Exp: %0b, Act: %0b", d2d_exp_out.resend_req, d2d_item.resend_req))
      error_count++;
      has_error = 1'b1;
    end

    // Check PHY outputs against phy_exp_out
    if (phy_item.resend_req !== phy_exp_out.resend_req) begin
      `uvm_error("PE_SBTX_SB", $sformatf("PHY resend_req Mismatch! Exp: %0b, Act: %0b", phy_exp_out.resend_req, phy_item.resend_req))
      error_count++;
      has_error = 1'b1;
    end

    // Check FIFO outputs against fifo_exp_out
    if (fifo_item.fifo_wr !== fifo_exp_out.fifo_wr) begin
      `uvm_error("PE_SBTX_SB", $sformatf("FIFO fifo_wr Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.fifo_wr, fifo_item.fifo_wr))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.fifo_data !== fifo_exp_out.fifo_data) begin
      `uvm_error("PE_SBTX_SB", $sformatf("FIFO fifo_data Mismatch! Exp: 0x%0h, Act: 0x%0h", fifo_exp_out.fifo_data, fifo_item.fifo_data))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.data_marker !== fifo_exp_out.data_marker) begin
      `uvm_error("PE_SBTX_SB", $sformatf("FIFO data_marker Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.data_marker, fifo_item.data_marker))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.d2d_phy_marker !== fifo_exp_out.d2d_phy_marker) begin
      `uvm_error("PE_SBTX_SB", $sformatf("FIFO d2d_phy_marker Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.d2d_phy_marker, fifo_item.d2d_phy_marker))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.comp_marker !== fifo_exp_out.comp_marker) begin
      `uvm_error("PE_SBTX_SB", $sformatf("FIFO comp_marker Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.comp_marker, fifo_item.comp_marker))
      error_count++;
      has_error = 1'b1;
    end

    if (!has_error) begin
      pass_count++;
    end
  endfunction
endclass

`endif // PE_SBTX_SCOREBOARD_SVH
