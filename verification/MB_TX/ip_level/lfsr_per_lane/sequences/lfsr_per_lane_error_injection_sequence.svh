`ifndef LFSR_PER_LANE_ERROR_INJECTION_SEQUENCE_SVH
`define LFSR_PER_LANE_ERROR_INJECTION_SEQUENCE_SVH

//-----------------------------------------------------------------------------
// lfsr_per_lane_error_injection_sequence
//
// Directed error / robustness sequence for the per-lane LFSR.
//
// Every cycle is generated by drive_cycle(), which:
//   * creates exactly one sequence item,
//   * drives RST_n / Opcode_Synch / EN / PN_EN / Data_In for that cycle,
//   * publishes the same item on p_sequencer.seqr_aport so the monitor can
//     associate the driven inputs with the outputs sampled in that cycle.
//
// The sequence is self contained: it enters through a clean reset and leaves
// the DUT in a known, normally-scrambling state.
//
// Injected scenarios (mapped to LFSR_PerLane.sv):
//   0) clean reset entry / release
//   1) baseline scrambling
//   2) opcode changes -> LFSR reseed (including a reserved opcode)
//   3) illegal / boundary EN & PN_EN combinations
//   4) PN_EN toggling (registered Data_Out / Valid path)
//   5) EN stall / resume toggling
//   6) asynchronous reset while active (RST_n priority)
//   7) opcode change while training (PN path active)
//   8) recovery: clean reset + normal scrambling
//
//-----------------------------------------------------------------------------

class lfsr_per_lane_error_injection_sequence extends uvm_sequence #(lfsr_per_lane_sequence_item);
  `uvm_object_utils(lfsr_per_lane_error_injection_sequence)
  `uvm_declare_p_sequencer(lfsr_per_lane_sequencer)

  // Opcode values.  OPCODE_SYNC is the normal synchronization opcode;
  // the others are deliberately different so the LFSR is reseeded.
  localparam bit [4:0] OPCODE_SYNC = 5'h15;
  localparam bit [4:0] OPCODE_ALT  = 5'h1A;
  localparam bit [4:0] OPCODE_RSVD = 5'h00;
  localparam bit [4:0] OPCODE_ALT2 = 5'h0F;

  // Data patterns used by run_cycles().
  typedef enum bit [1:0] {
    PAT_ZERO = 2'd0,
    PAT_ONE  = 2'd1,
    PAT_ALT  = 2'd2,
    PAT_RAND = 2'd3
  } data_pat_e;

  // Knobs.  They can be overridden before start() if a test needs a
  // longer/shorter stress or wants to exercise reset priority.
  int unsigned scrub_len           = 16;
  bit          test_reset_priority = 1'b1;

  // Number of cycles driven, for the end-of-sequence log.
  int unsigned cycles_driven = 0;

  function new(string name = "lfsr_per_lane_error_injection_sequence");
    super.new(name);
  endfunction

  //----------------------------------------------------------------------------
  // Drive one cycle and publish the inputs to the monitor.
  //----------------------------------------------------------------------------
  task drive_cycle(string    name,
                   bit       rst_n,
                   bit [4:0] opcode,
                   bit       en,
                   bit       pn_en,
                   bit       data_in);
    lfsr_per_lane_sequence_item req;

    req = lfsr_per_lane_sequence_item::type_id::create(name);
    start_item(req);
    req.RST_n        = rst_n;
    req.Opcode_Synch = opcode;
    req.EN            = en;
    req.PN_EN         = pn_en;
    req.Data_In       = data_in;
    finish_item(req);

    // One write per driven cycle.  The monitor copies these fields and pairs
    // them with the outputs it samples for this cycle.
    p_sequencer.seqr_aport.write(req);

    cycles_driven++;
  endtask

  //----------------------------------------------------------------------------
  // Data pattern helper.
  //----------------------------------------------------------------------------
  function bit data_for(data_pat_e pat, int unsigned idx);
    case (pat)
      PAT_ZERO: return 1'b0;
      PAT_ONE:  return 1'b1;
      PAT_ALT:  return idx[0];
      default:  return $urandom_range(0, 1);
    endcase
  endfunction

  //----------------------------------------------------------------------------
  // Reset block: assert reset for low_cycles, then release with idle inputs.
  //----------------------------------------------------------------------------
  task reset_block(string tag, int unsigned low_cycles, int unsigned release_cycles);
    for (int unsigned i = 0; i < low_cycles; i++)
      drive_cycle($sformatf("%s_rst_low_%0d", tag, i),
                  1'b0, OPCODE_SYNC, 1'b0, 1'b0, 1'b0);

    for (int unsigned i = 0; i < release_cycles; i++)
      drive_cycle($sformatf("%s_rst_rel_%0d", tag, i),
                  1'b1, OPCODE_SYNC, 1'b0, 1'b0, 1'b0);
  endtask

  //----------------------------------------------------------------------------
  // Run n cycles with fixed RST_n/opcode/EN/PN_EN and a data pattern.
  //----------------------------------------------------------------------------
  task run_cycles(string tag, int unsigned n, bit [4:0] opcode,
                  bit en, bit pn_en, data_pat_e pat);
    for (int unsigned i = 0; i < n; i++)
      drive_cycle($sformatf("%s_%0d", tag, i),
                  1'b1, opcode, en, pn_en, data_for(pat, i));
  endtask

  //----------------------------------------------------------------------------
  // Main sequence.
  //----------------------------------------------------------------------------
  task body();
    `uvm_info("ERR_SEQ", "==================================================", UVM_LOW)
    `uvm_info("ERR_SEQ", " LFSR per-lane directed error injection", UVM_LOW)
    `uvm_info("ERR_SEQ", "==================================================", UVM_LOW)

    //--------------------------------------------------------------------
    // 0) Clean entry: seed the LFSR and leave reset with idle inputs.
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[0] Clean reset entry", UVM_LOW)
    reset_block("entry", 3, 2);

    //--------------------------------------------------------------------
    // 1) Baseline: normal scrambling, establish LFSR movement.
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[1] Baseline scramble", UVM_LOW)
    run_cycles("base_zero", 4, OPCODE_SYNC, 1'b1, 1'b0, PAT_ZERO);
    run_cycles("base_one",  4, OPCODE_SYNC, 1'b1, 1'b0, PAT_ONE);
    run_cycles("base_alt",  scrub_len, OPCODE_SYNC, 1'b1, 1'b0, PAT_ALT);

    //--------------------------------------------------------------------
    // 2) Opcode glitches: each opcode change reseeds the LFSR, then normal
    //    stepping resumes.  A reserved opcode is included on purpose.
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[2] Opcode-change / reseed injection", UVM_LOW)
    drive_cycle("op_alt_0",  1'b1, OPCODE_ALT,  1'b1, 1'b0, 1'b0);
    drive_cycle("op_alt_1",  1'b1, OPCODE_ALT,  1'b1, 1'b0, 1'b1);
    drive_cycle("op_rsvd_0", 1'b1, OPCODE_RSVD, 1'b1, 1'b0, 1'b0);
    drive_cycle("op_rsvd_1", 1'b1, OPCODE_RSVD, 1'b1, 1'b0, 1'b1);
    drive_cycle("op_alt2_0", 1'b1, OPCODE_ALT2, 1'b1, 1'b0, 1'b0);
    drive_cycle("op_sync_0", 1'b1, OPCODE_SYNC, 1'b1, 1'b0, 1'b1);
    run_cycles("op_recover", 8, OPCODE_SYNC, 1'b1, 1'b0, PAT_ALT);

    //--------------------------------------------------------------------
    // 3) Illegal / boundary EN & PN_EN combinations:
    //    - EN=0, PN_EN=1 : PN path selected while the LFSR is frozen
    //    - EN=1, PN_EN=1 : training
    //    - EN=0, PN_EN=1 : again, now with the PN register cleared
    //    - EN=0, PN_EN=0 : bypass
    //    - EN=1, PN_EN=0 : scramble recovery
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[3] EN/PN_EN illegal and boundary combinations", UVM_LOW)
    run_cycles("pn_without_en",  4, OPCODE_SYNC, 1'b0, 1'b1, PAT_ALT);
    run_cycles("train_ref",      4, OPCODE_SYNC, 1'b1, 1'b1, PAT_ALT);
    run_cycles("pn_after_train", 4, OPCODE_SYNC, 1'b0, 1'b1, PAT_ONE);
    run_cycles("bypass",         4, OPCODE_SYNC, 1'b0, 1'b0, PAT_ALT);
    run_cycles("scr_recover",    8, OPCODE_SYNC, 1'b1, 1'b0, PAT_ALT);

    //--------------------------------------------------------------------
    // 4) PN_EN toggling: exercises the registered Data_Out/Valid path on
    //    every other cycle.
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[4] PN_EN toggling", UVM_LOW)
    for (int unsigned i = 0; i < 8; i++)
      drive_cycle($sformatf("pn_toggle_%0d", i),
                  1'b1, OPCODE_SYNC, 1'b1, i[0], i[1]);
    run_cycles("train_cont", 8, OPCODE_SYNC, 1'b1, 1'b1, PAT_ALT);
    run_cycles("pn_recover", 8, OPCODE_SYNC, 1'b1, 1'b0, PAT_ALT);

    //--------------------------------------------------------------------
    // 5) EN stall/resume toggling: the LFSR holds while EN=0 and resumes
    //    stepping when EN returns high.
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[5] EN stall/resume toggling", UVM_LOW)
    for (int unsigned i = 0; i < 8; i++)
      drive_cycle($sformatf("en_toggle_%0d", i),
                  1'b1, OPCODE_SYNC, i[0], 1'b0, i[1]);
    run_cycles("en_recover", 8, OPCODE_SYNC, 1'b1, 1'b0, PAT_ALT);

    //--------------------------------------------------------------------
    // 6) Asynchronous reset while the lane is active.
    //    With test_reset_priority=1, EN/PN_EN are also asserted during
    //    reset to prove RST_n has priority over them.
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[6] Reset while active", UVM_LOW)
    run_cycles("pre_rst_train", 4, OPCODE_SYNC, 1'b1, 1'b1, PAT_ALT);
    if (test_reset_priority) begin
      drive_cycle("rst_active_0", 1'b0, OPCODE_SYNC, 1'b1, 1'b0, 1'b1);
      drive_cycle("rst_active_1", 1'b0, OPCODE_SYNC, 1'b1, 1'b1, 1'b0);
    end
    else begin
      drive_cycle("rst_active_0", 1'b0, OPCODE_SYNC, 1'b0, 1'b0, 1'b0);
      drive_cycle("rst_active_1", 1'b0, OPCODE_SYNC, 1'b0, 1'b0, 1'b0);
    end
    drive_cycle("rst_release", 1'b1, OPCODE_SYNC, 1'b0, 1'b0, 1'b0);
    drive_cycle("rst_settle",  1'b1, OPCODE_SYNC, 1'b0, 1'b0, 1'b0);
    run_cycles("post_rst", 8, OPCODE_SYNC, 1'b1, 1'b0, PAT_ALT);

    //--------------------------------------------------------------------
    // 7) Opcode change while training (PN path active).
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[7] Opcode change during training", UVM_LOW)
    run_cycles("train_pre_op", 4, OPCODE_SYNC, 1'b1, 1'b1, PAT_ALT);
    drive_cycle("train_op_change",  1'b1, OPCODE_ALT,  1'b1, 1'b1, 1'b1);
    run_cycles("train_alt", 4, OPCODE_ALT,  1'b1, 1'b1, PAT_ALT);
    drive_cycle("train_op_restore", 1'b1, OPCODE_SYNC, 1'b1, 1'b1, 1'b0);
    run_cycles("train_post_op", 4, OPCODE_SYNC, 1'b1, 1'b1, PAT_ALT);

    //--------------------------------------------------------------------
    // 8) Recovery: clean reset then a final normal scramble run.
    //--------------------------------------------------------------------
    `uvm_info("ERR_SEQ", "[8] Recovery to normal scrambling", UVM_LOW)
    reset_block("final", 2, 2);
    run_cycles("final_scr", scrub_len, OPCODE_SYNC, 1'b1, 1'b0, PAT_ALT);

    `uvm_info("ERR_SEQ",
      $sformatf("Error injection complete: %0d cycles driven", cycles_driven), UVM_LOW)
    `uvm_info("ERR_SEQ", "==================================================", UVM_LOW)
  endtask
endclass

`endif // LFSR_PER_LANE_ERROR_INJECTION_SEQUENCE_SVH
