`ifndef PE_SBTX_SCOREBOARD_SVH
`define PE_SBTX_SCOREBOARD_SVH

class pe_sbtx_scoreboard extends uvm_scoreboard;
  `uvm_component_utils(pe_sbtx_scoreboard)
  
  uvm_analysis_export#(pe_sbtx_D2D_sequence_item) sb_d2d_aexport;
  uvm_analysis_export#(pe_sbtx_PHY_sequence_item) sb_phy_aexport;
  uvm_analysis_export#(pe_sbtx_FIFO_sequence_item) sb_fifo_aexport;
  
  uvm_tlm_analysis_fifo#(pe_sbtx_D2D_sequence_item) sb_d2d_fifo;
  uvm_tlm_analysis_fifo#(pe_sbtx_PHY_sequence_item) sb_phy_fifo;
  uvm_tlm_analysis_fifo#(pe_sbtx_FIFO_sequence_item) sb_fifo_fifo;
  
  // Expected outputs generated by the reference model
  pe_sbtx_FIFO_sequence_item fifo_exp_out;
  logic exp_phy_resend_req;
  logic exp_d2d_resend_req;
  
  // Reference model state variables
  typedef enum logic[1:0] {
    OWNER_NONE = 2'b00, OWNER_D2D = 2'b01, OWNER_PHY = 2'b10} owner_e;
  
  owner_e active_owner;
  int phase_timer;
  logic stored_phy_resend;
  logic stored_d2d_resend;
  
  // Scoreboard statistics
  int pass_count;
  int error_count;
  
  function new(string name = "pe_sbtx_scoreboard", uvm_component parent = null);
    super.new(name, parent);
  endfunction
  
  function void build_phase(uvm_phase phase);
    super.build_phase(phase);
    sb_d2d_aexport = new("sb_d2d_aexport", this);
    sb_phy_aexport = new("sb_phy_aexport", this);
    sb_fifo_aexport = new("sb_fifo_aexport", this);
    
    sb_d2d_fifo = new("sb_d2d_fifo", this);
    sb_phy_fifo = new("sb_phy_fifo", this);
    sb_fifo_fifo = new("sb_fifo_fifo", this);
    
    fifo_exp_out = pe_sbtx_FIFO_sequence_item::type_id::create("fifo_exp_out");
    
    active_owner = OWNER_NONE;
    phase_timer = 0;
    stored_phy_resend = 1'b0;
    stored_d2d_resend = 1'b0;
    exp_phy_resend_req = 1'b0;
    exp_d2d_resend_req = 1'b0;
    
    pass_count = 0;
    error_count = 0;
  endfunction
  
  function void connect_phase(uvm_phase phase);
    super.connect_phase(phase);
    
    sb_d2d_aexport.connect(sb_d2d_fifo.analysis_export);
    sb_phy_aexport.connect(sb_phy_fifo.analysis_export);
    sb_fifo_aexport.connect(sb_fifo_fifo.analysis_export);
  endfunction
  
  task run_phase(uvm_phase phase);
    pe_sbtx_D2D_sequence_item d2d_item;
    pe_sbtx_PHY_sequence_item phy_item;
    pe_sbtx_FIFO_sequence_item fifo_item;
    
    super.run_phase(phase);
    
    // Skip the first item, all the modules are initialized to 0, so the first item is not valid
    sb_d2d_fifo.get(d2d_item);
    sb_phy_fifo.get(phy_item);
    sb_fifo_fifo.get(fifo_item);
    
    forever begin
      sb_d2d_fifo.get(d2d_item);
      sb_phy_fifo.get(phy_item);
      sb_fifo_fifo.get(fifo_item);
      
      ref_model(d2d_item, phy_item);
      check_results(d2d_item, phy_item, fifo_item);
    end
  endtask
  
  function void report_phase(uvm_phase phase);
    super.report_phase(phase);
    `uvm_info("SBTX_PE_SB", "==================================================", UVM_NONE)
    `uvm_info("SBTX_PE_SB", "             SCOREBOARD SUMMARY REPORT            ", UVM_NONE)
    `uvm_info("SBTX_PE_SB", "==================================================", UVM_NONE)
    `uvm_info("SBTX_PE_SB", $sformatf("  Pass Count  : %0d", pass_count), UVM_NONE)
    `uvm_info("SBTX_PE_SB", $sformatf("  Error Count : %0d", error_count), UVM_NONE)
    `uvm_info("SBTX_PE_SB", "==================================================", UVM_NONE)
  endfunction
  
  function void ref_model(pe_sbtx_D2D_sequence_item d2d_item, pe_sbtx_PHY_sequence_item phy_item);
    bit phy_req = phy_item.en;
    bit d2d_req = d2d_item.en;
    
    // =====================================================================
    // 0. Asynchronous Reset Handling (RST_n == 0)
    // =====================================================================
    if (!phy_item.rst_n) begin
      active_owner = OWNER_NONE;
      phase_timer = 0;
      stored_phy_resend = 1'b0;
      stored_d2d_resend = 1'b0;
      exp_phy_resend_req = 1'b0;
      exp_d2d_resend_req = 1'b0;
      
      fifo_exp_out.fifo_wr = 1'b0;
      fifo_exp_out.fifo_data = '0;
      fifo_exp_out.data_marker = 1'b0;
      fifo_exp_out.comp_marker = 1'b0;
      fifo_exp_out.d2d_phy_marker = 1'b0;
      return;
    end
    
    // =====================================================================
    // 1. Drive Delayed Resend Requests
    // =====================================================================
    // Output the resend requests that were determined in the PREVIOUS cycle
    exp_phy_resend_req = stored_phy_resend;
    exp_d2d_resend_req = stored_d2d_resend;
    
    // Default to 0 for the NEXT cycle unless proven otherwise below
    stored_phy_resend = 1'b0;
    stored_d2d_resend = 1'b0;
    
    // =====================================================================
    // 2. Drive Combinational Datapath Outputs
    // =====================================================================
    // Determine the FIFO outputs based on who currently owns the channel
    fifo_exp_out.fifo_wr = 1'b0;
    fifo_exp_out.fifo_data = '0;
    fifo_exp_out.data_marker = 1'b0;
    fifo_exp_out.comp_marker = 1'b0;
    fifo_exp_out.d2d_phy_marker = 1'b0;
    
    if (active_owner == OWNER_PHY) begin
      fifo_exp_out.fifo_wr = 1'b1;
      fifo_exp_out.fifo_data = phy_item.data;
      fifo_exp_out.data_marker = phy_item.data_marker;
      fifo_exp_out.comp_marker = 1'b0; // PHY never has a completion marker
      fifo_exp_out.d2d_phy_marker = 1'b0;
    end
    else if (active_owner == OWNER_D2D) begin
      fifo_exp_out.fifo_wr = 1'b1;
      fifo_exp_out.fifo_data = d2d_item.data;
      fifo_exp_out.data_marker = d2d_item.data_marker;
      fifo_exp_out.comp_marker = d2d_item.comp_marker;
      fifo_exp_out.d2d_phy_marker = 1'b1;
    end
    
    // =====================================================================
    // 3. Evaluate Arbitration & Phase Timer for the NEXT Cycle
    // =====================================================================
    if (phase_timer > 0) begin
      // --- CHANNEL IS LOCKED (2-phase packet in progress) ---
      phase_timer--;
      
      // Resend request rules per Functional Spec Sections 4.2 & 5:
      // - Simultaneous contention (2'b11) always asserts D2D_Resend_Req = 1 (and PHY_Resend_Req = 0)
      // - Exclusive request from the non-owning master during lock asserts its Resend_Req
      if (phy_req && d2d_req) begin
        stored_d2d_resend = 1'b1;
      end
      else if (d2d_req && (active_owner == OWNER_PHY)) begin
        stored_d2d_resend = 1'b1;
      end
      else if (phy_req && (active_owner == OWNER_D2D)) begin
        stored_phy_resend = 1'b1;
      end
      
      // If the timer just hit 0, the 2-phase packet is done.
      // Clear the owner so the NEXT cycle is a mandatory 1-cycle idle cooldown bubble.
      if (phase_timer == 0) begin
        active_owner = OWNER_NONE;
      end
    end
    else begin
      // --- CHANNEL IS UNLOCKED ---
      if (phy_req) begin
        active_owner = OWNER_PHY;
        phase_timer = phy_item.data_marker ? 2 : 0; // Lock for 2 cycles only if multi-phase data packet
        
        if (d2d_req) begin
          stored_d2d_resend = 1'b1;
        end
      end
      else if (d2d_req) begin
        active_owner = OWNER_D2D;
        phase_timer = d2d_item.data_marker ? 2 : 0; // Lock for 2 cycles only if multi-phase data packet
      end
      else begin
        active_owner = OWNER_NONE;
      end
    end
  endfunction
  
  function void check_results(pe_sbtx_D2D_sequence_item d2d_item, pe_sbtx_PHY_sequence_item phy_item, pe_sbtx_FIFO_sequence_item fifo_item);
    bit has_error = 1'b0;
    
    // Check FIFO outputs against fifo_exp_out
    if (fifo_item.fifo_wr !== fifo_exp_out.fifo_wr) begin
      `uvm_error("SBTX_PE_SB", $sformatf("FIFO_WR Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.fifo_wr, fifo_item.fifo_wr))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.fifo_data !== fifo_exp_out.fifo_data) begin
      `uvm_error("SBTX_PE_SB", $sformatf("FIFO_DATA Mismatch! Exp: 0x%0h, Act: 0x%0h", fifo_exp_out.fifo_data, fifo_item.fifo_data))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.data_marker !== fifo_exp_out.data_marker) begin
      `uvm_error("SBTX_PE_SB", $sformatf("DATA_MARKER Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.data_marker, fifo_item.data_marker))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.comp_marker !== fifo_exp_out.comp_marker) begin
      `uvm_error("SBTX_PE_SB", $sformatf("COMP_MARKER Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.comp_marker, fifo_item.comp_marker))
      error_count++;
      has_error = 1'b1;
    end
    if (fifo_item.d2d_phy_marker !== fifo_exp_out.d2d_phy_marker) begin
      `uvm_error("SBTX_PE_SB", $sformatf("D2D_PHY_MARKER Mismatch! Exp: %0b, Act: %0b", fifo_exp_out.d2d_phy_marker, fifo_item.d2d_phy_marker))
      error_count++;
      has_error = 1'b1;
    end
    
    // Check Resend Requests
    if (phy_item.resend_req !== exp_phy_resend_req) begin
      `uvm_error("SBTX_PE_SB", $sformatf("PHY_Resend_Req Mismatch! Exp: %0b, Act: %0b", exp_phy_resend_req, phy_item.resend_req))
      error_count++;
      has_error = 1'b1;
    end
    if (d2d_item.resend_req !== exp_d2d_resend_req) begin
      `uvm_error("SBTX_PE_SB", $sformatf("D2D_Resend_Req Mismatch! Exp: %0b, Act: %0b", exp_d2d_resend_req, d2d_item.resend_req))
      error_count++;
      has_error = 1'b1;
    end
    
    if (!has_error) begin
      pass_count++;
    end
  endfunction
endclass

`endif // PE_SBTX_SCOREBOARD_SVH