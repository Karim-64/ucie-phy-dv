`ifndef CREDITS_HANDLER_SBTX_SEQUENCE_ITEM_SVH
`define CREDITS_HANDLER_SBTX_SEQUENCE_ITEM_SVH

class Credits_Handler_SBTX_sequence_item extends uvm_sequence_item;
  `uvm_object_utils(Credits_Handler_SBTX_sequence_item)

  // -------------------------------------------------------------------------
  //  Stimulus fields (directly driven to the DUT) - declared rand
  // -------------------------------------------------------------------------
  rand logic rst_n;
  rand logic comp_sent;
  rand logic UIE;
  rand logic credit;
  rand logic D2D_phy_marker;
  rand logic data_marker;
  rand logic comp_marker;
  // -------------------------------------------------------------------------
  //  Response fields (sampled from the DUT) - NOT rand
  // -------------------------------------------------------------------------
  logic pl_cfg_crd;
  // -------------------------------------------------------------------------
  //  Constructor
  // -------------------------------------------------------------------------
  function new(string name = "Credits_Handler_SBTX_sequence_item");
    super.new(name);
  endfunction

  // -------------------------------------------------------------------------
  //  Constraints
  // -------------------------------------------------------------------------
  constraint c_rst_n{
    rst_n dist {0 := 1, 1 := 9};  
  }
  constraint c_decoder_mut_ex{ // both signals are generated by decoder which processes one message per clock cycle,
    !(credit && comp_sent);    // which can either be a completion or an unsupported request
  }
  // -------------------------------------------------------------------------
  //  convert2string - human-readable representation for logs / debug
  // -------------------------------------------------------------------------
  virtual function string convert2string();
    return $sformatf("Credits_Handler_SBTX_seq_item: rst_n=%0b comp_sent=%0b UIE=%0b credit=%0b D2D_phy_marker=%0b data_marker=%0b comp_marker=%0b pl_cfg_crd=%0b",
      rst_n, comp_sent, UIE, credit, D2D_phy_marker, data_marker, comp_marker, pl_cfg_crd);
  endfunction

endclass

`endif // CREDITS_HANDLER_SBTX_SEQUENCE_ITEM_SVH
